<Window x:Class="_423_Marketplace_Zhalyuk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Маркетплейс товаров" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBack" Grid.Column="0" Content="Назад"
                    Width="120" Margin="15,10,0,10"
                    HorizontalAlignment="Left"
                    Click="BtnBack_Click"/>

            <TextBlock Grid.Column="1" Text="Маркетплейс товаров"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundBrush}"/>

            <Button x:Name="BtnTheme" Grid.Column="2" Content="Сменить тему"
                    Width="150" Margin="0,10,15,10"
                    HorizontalAlignment="Right"
                    Click="BtnTheme_Click"/>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource BackgroundBrush}"/>

        <TextBlock x:Name="DateTimeNow" Grid.Row="2"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,20,0" FontSize="14"/>
    </Grid>
</Window>