<Window x:Class="_423_Marketplace_Zhalyuk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marketplace" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Button x:Name="BtnBack" Grid.Row="0" Content="Назад"
                HorizontalAlignment="Left" Width="120" Margin="15,10,0,10"
                Click="BtnBack_Click"/>

        <Button x:Name="BtnTheme" Grid.Row="0" Content="Сменить тему"
                HorizontalAlignment="Right" Width="150" Margin="0,10,15,10"
                Click="BtnTheme_Click"/>

        <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource BackgroundBrush}"/>

        <TextBlock x:Name="DateTimeNow" Grid.Row="2"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,20,0" FontSize="14"/>
    </Grid>
</Window>