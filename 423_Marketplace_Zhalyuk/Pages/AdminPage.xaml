<Page x:Class="_423_Marketplace_Zhalyuk.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора"
      Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Панель администратора" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Таблица пользователей" Click="BtnTab1_Click" Margin="10" Width="200"/>
                <Button Content="Таблица категорий" Click="BtnTab2_Click" Margin="10" Width="200"/>
                <Button Content="Таблица товаров" Click="BtnTab3_Click" Margin="10" Width="200"/>
            </StackPanel>
            <Button Content="Диаграммы" Click="BtnTab4_Click" Margin="10,20,10,10" Width="200" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>