<Page x:Class="_423_Marketplace_Zhalyuk.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Категория">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Название категории" FontSize="16" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TBCategoryName"
                 Text="{Binding Name}" Margin="5" ToolTip="Введите название"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="ButtonSaveCategory" Content="Сохранить"
                    Width="150" Margin="5" Click="ButtonSaveCategory_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить"
                    Width="150" Margin="5" Click="ButtonClean_Click"/>
        </StackPanel>
    </Grid>
</Page>