<Page x:Class="_423_Marketplace_Zhalyuk.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="61*"/>
            <ColumnDefinition Width="739*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">

            <TextBlock Text="Смена пароля" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Left" Margin="69,0,0,20"/>

            <Label Content="Введите логин"
                   HorizontalAlignment="Left" Margin="69,10,0,0"/>
            <Grid HorizontalAlignment="Left" Margin="69,0,0,0" Width="320">
                <TextBox x:Name="TbLogin" Width="320"
                         ToolTip="Ваш логин"
                         TextChanged="TbLogin_TextChanged"/>
                <TextBlock x:Name="HintLogin" Text="Введите логин"
                           Foreground="Gray" FontSize="14"
                           Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           MouseLeftButtonUp="HintLogin_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Текущий пароль"
                   HorizontalAlignment="Left" Margin="69,10,0,0"/>
            <Grid HorizontalAlignment="Left" Margin="69,0,0,0" Width="320">
                <PasswordBox x:Name="CurrentPasswordBox" Width="320"
                             ToolTip="Введите текущий пароль"
                             PasswordChanged="CurrentPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="HintCurrent" Text="Введите текущий пароль"
                           Foreground="Gray" FontSize="14"
                           Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           MouseLeftButtonUp="HintCurrent_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Новый пароль"
                   HorizontalAlignment="Left" Margin="69,10,0,0"/>
            <Grid HorizontalAlignment="Left" Margin="69,0,0,0" Width="320">
                <PasswordBox x:Name="NewPasswordBox" Width="320"
                             ToolTip="Введите новый пароль"
                             PasswordChanged="NewPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="HintNew" Text="Введите новый пароль"
                           Foreground="Gray" FontSize="14"
                           Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           MouseLeftButtonUp="HintNew_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Подтвердите новый пароль"
                   HorizontalAlignment="Left" Margin="69,10,0,0"/>
            <Grid HorizontalAlignment="Left" Margin="69,0,0,0" Width="320">
                <PasswordBox x:Name="ConfirmPasswordBox" Width="320"
                             ToolTip="Повторите новый пароль"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="HintConfirm" Text="Повторите новый пароль"
                           Foreground="Gray" FontSize="14"
                           Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           MouseLeftButtonUp="HintConfirm_MouseLeftButtonUp"/>
            </Grid>

            <Button x:Name="ButtonSave" Content="Сохранить"
                    Width="200" Height="34"
                    Margin="69,20,0,0" HorizontalAlignment="Left"
                    ToolTip="Сменить пароль"
                    Click="ButtonSave_Click"/>

        </StackPanel>
    </Grid>
</Page>