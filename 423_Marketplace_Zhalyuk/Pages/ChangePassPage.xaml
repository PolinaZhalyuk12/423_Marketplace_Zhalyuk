<Page x:Class="_423_Marketplace_Zhalyuk.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля"
      Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Border Background="{DynamicResource InputBgBrush}" 
                CornerRadius="10" 
                Padding="40" 
                Width="400"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Смена пароля" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Label Content="Введите логин" HorizontalAlignment="Left"/>
                <Grid>
                    <TextBox x:Name="TbLogin" ToolTip="Ваш логин" TextChanged="TbLogin_TextChanged"/>
                    <TextBlock x:Name="HintLogin" Text="Введите логин"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="HintLogin_MouseLeftButtonUp"/>
                </Grid>

                <Label Content="Текущий пароль" HorizontalAlignment="Left"/>
                <Grid>
                    <PasswordBox x:Name="CurrentPasswordBox" ToolTip="Введите текущий пароль" PasswordChanged="CurrentPasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="HintCurrent" Text="Введите текущий пароль"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="HintCurrent_MouseLeftButtonUp"/>
                </Grid>

                <Label Content="Новый пароль" HorizontalAlignment="Left"/>
                <Grid>
                    <PasswordBox x:Name="NewPasswordBox" ToolTip="Введите новый пароль" PasswordChanged="NewPasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="HintNew" Text="Введите новый пароль"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="HintNew_MouseLeftButtonUp"/>
                </Grid>

                <Label Content="Подтвердите новый пароль" HorizontalAlignment="Left"/>
                <Grid>
                    <PasswordBox x:Name="ConfirmPasswordBox" ToolTip="Повторите новый пароль" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="HintConfirm" Text="Повторите новый пароль"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="HintConfirm_MouseLeftButtonUp"/>
                </Grid>

                <Button x:Name="ButtonSave" Content="Сохранить" Margin="0,20,0,0"
                        HorizontalAlignment="Stretch" Click="ButtonSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>