<Page x:Class="_423_Marketplace_Zhalyuk.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи"
      Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <TextBlock Text="Введите ФИО для поиска:"
                       VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="fioFilterTextBox"
                     MinWidth="150" Margin="5"
                     ToolTip="Поиск по ФИО"
                     TextChanged="fioFilterTextBox_TextChanged"/>

            <TextBlock Text="Сортировка по ФИО:"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
            <ComboBox x:Name="sortComboBox"
                      SelectedIndex="0" MinWidth="150" Margin="5"
                      ToolTip="Направление сортировки"
                      SelectionChanged="sortComboBox_SelectionChanged">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <CheckBox x:Name="onlyAdminCheckBox"
                      Content="Только администраторы"
                      VerticalAlignment="Center" Margin="15,0,0,0"
                      Checked="onlyAdminCheckBox_Checked"
                      Unchecked="onlyAdminCheckBox_Unchecked"/>

            <Button x:Name="clearFiltersButton"
                    Content="Очистить фильтр"
                    Height="34" Width="150" Margin="15,0,0,0"
                    ToolTip="Сбросить все фильтры"
                    Click="clearFiltersButton_Click"/>
        </WrapPanel>

        <ListView x:Name="ListUser" Grid.Row="1"
                  HorizontalContentAlignment="Center"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Margin="5">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#8B5CF6" BorderThickness="1"
                            CornerRadius="8" Margin="10" Padding="10"
                            Width="220">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0" Width="200" Height="200"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="Photo">
                                        <Binding.TargetNullValue>
                                            <ImageSource>/res/default.png</ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>

                            <TextBlock Grid.Row="1" Text="{Binding FIO}"
                                       FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="2" Text="{Binding Role.Name}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="#A78BFA"
                                       Margin="0,5,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>