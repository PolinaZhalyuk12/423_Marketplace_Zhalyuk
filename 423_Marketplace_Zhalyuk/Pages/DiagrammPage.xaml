<Page x:Class="_423_Marketplace_Zhalyuk.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      Title="Диаграммы">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal"
                   HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="Продавец:"
                       VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="CmbUser" MinWidth="200" Margin="5"
                      DisplayMemberPath="FIO"
                      SelectionChanged="UpdateChart"/>

            <TextBlock Text="Тип диаграммы:"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox x:Name="CmbDiagram" MinWidth="200" Margin="5"
                      SelectionChanged="UpdateChart"/>

            <Button x:Name="BtnExportWord" Content="Экспорт в Word"
                    Width="150" Height="34" Margin="20,0,0,0"
                    Click="BtnExportWord_Click"/>
            <Button x:Name="BtnExportExcel" Content="Экспорт в Excel"
                    Width="150" Height="34" Margin="10,0,0,0"
                    Click="BtnExportExcel_Click"/>
        </WrapPanel>

        <wf:WindowsFormsHost Grid.Row="1" Margin="10" x:Name="ChartHost" />
    </Grid>
</Page>