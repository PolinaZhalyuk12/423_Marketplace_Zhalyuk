<Page x:Class="_423_Marketplace_Zhalyuk.Pages.AddProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товар">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" FontSize="16" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TBName"
                 Text="{Binding Name}" Margin="5" ToolTip="Название товара"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Цена" FontSize="16" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TBPrice"
                 Text="{Binding Price}" Margin="5" ToolTip="Цена"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Количество" FontSize="16" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TBQuantity"
                 Text="{Binding Quantity}" Margin="5" ToolTip="Количество на складе"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория" FontSize="16" Margin="5"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CBCategory"
                  DisplayMemberPath="Name" Margin="5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Продавец" FontSize="16" Margin="5"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CBUser"
                  DisplayMemberPath="FIO" Margin="5"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="ButtonSave" Content="Сохранить"
                    Width="150" Margin="5" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить"
                    Width="150" Margin="5" Click="ButtonClean_Click"/>
        </StackPanel>
    </Grid>
</Page>