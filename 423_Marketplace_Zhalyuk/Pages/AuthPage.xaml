<Page x:Class="_423_Marketplace_Zhalyuk.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Border Background="{DynamicResource InputBgBrush}" 
                CornerRadius="10" 
                Padding="40" 
                Width="400"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Авторизация" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Label x:Name="labelLogin" Content="Введите логин" />
                <Grid>
                    <TextBox x:Name="TextBoxLogin" ToolTip="Введите логин" TextChanged="TextBoxLogin_TextChanged"/>
                    <TextBlock x:Name="txtHintLogin" Text="Введите логин"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="txtHintLogin_MouseLeftButtonUp"/>
                </Grid>

                <Label x:Name="labelPass" Content="Введите пароль" />
                <Grid>
                    <PasswordBox x:Name="PasswordBox" ToolTip="Введите пароль" PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="txtHintPass" Text="Введите пароль"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="txtHintPass_MouseLeftButtonUp"/>
                </Grid>

                <Button x:Name="ButtonEnter" Content="Вход" Margin="0,20,0,10"
                        HorizontalAlignment="Stretch" Click="ButtonEnter_Click"/>
                <Button x:Name="ButtonReg" Content="Регистрация" Margin="0,0,0,10"
                        HorizontalAlignment="Stretch" Click="ButtonReg_Click"/>
                <Button x:Name="ButtonChangePassword" Content="Смена пароля" Margin="0"
                        HorizontalAlignment="Stretch" Click="ButtonChangePassword_Click"/>

                <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Margin="0,15,0,0">
                    <TextBox x:Name="captcha" IsReadOnly="True" FontSize="22" FontStyle="Italic"
                             FontWeight="Bold" Foreground="Red" HorizontalContentAlignment="Center"
                             Background="Transparent" BorderThickness="0" Margin="0,0,0,5"/>
                    <TextBox x:Name="captchaInput" ToolTip="Введите капчу"/>
                    <Button x:Name="submitCaptcha" Content="Проверить" HorizontalAlignment="Stretch" Click="submitCaptcha_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>