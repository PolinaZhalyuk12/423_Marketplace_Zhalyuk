<Page x:Class="_423_Marketplace_Zhalyuk.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация"
      Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Border Background="{DynamicResource InputBgBrush}" 
                CornerRadius="10" 
                Padding="40" 
                Width="400"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Label Content="Введите логин" HorizontalAlignment="Left"/>
                <Grid>
                    <TextBox x:Name="txtbxLog" ToolTip="Введите логин" TextChanged="txtbxLog_TextChanged"/>
                    <TextBlock x:Name="lblLogHint" Text="Введите логин"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="lblLogHint_MouseLeftButtonUp"/>
                </Grid>

                <Label Content="Введите пароль" HorizontalAlignment="Left"/>
                <Grid>
                    <PasswordBox x:Name="passBxFrst" ToolTip="Введите пароль" PasswordChanged="passBxFrst_PasswordChanged"/>
                    <TextBlock x:Name="lblPassHint" Text="Введите пароль"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="lblPassHint_MouseLeftButtonUp"/>
                </Grid>

                <Label Content="Подтвердите пароль" HorizontalAlignment="Left"/>
                <Grid>
                    <PasswordBox x:Name="passBxScnd" ToolTip="Повторите пароль" PasswordChanged="passBxScnd_PasswordChanged"/>
                    <TextBlock x:Name="lblPassSecHint" Text="Повторите пароль"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="lblPassSecHint_MouseLeftButtonUp"/>
                </Grid>

                <Label Content="Выберите роль" HorizontalAlignment="Left"/>
                <ComboBox x:Name="comboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="Buyer"/>
                    <ComboBoxItem Content="Seller"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>

                <Label Content="Введите ФИО" HorizontalAlignment="Left"/>
                <Grid>
                    <TextBox x:Name="txtbxFIO" ToolTip="Введите ФИО" TextChanged="txtbxFIO_TextChanged"/>
                    <TextBlock x:Name="lblFioHint" Text="Введите ФИО"
                               Foreground="{DynamicResource PlaceholderBrush}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" MouseLeftButtonUp="lblFioHint_MouseLeftButtonUp"/>
                </Grid>

                <Button x:Name="regButton" Content="Зарегистрироваться" Margin="0,20,0,0"
                        HorizontalAlignment="Stretch" Click="regButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>